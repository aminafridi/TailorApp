@{
    ViewData["Title"] = "Error";
}

<div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-12 text-center max-w-2xl mx-auto mt-8 shadow-sm">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-50 dark:bg-red-900/20 text-red-500 mb-4">
        <span class="text-3xl">⚠️</span>
    </div>
    <h1 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Something went wrong</h1>
    <p class="text-gray-500 dark:text-gray-400 mb-6">The page could not be completed, so your last change may not have been saved. Please go back and try again.</p>
    <a asp-controller="Home" asp-action="Index" class="inline-flex items-center px-6 py-3 bg-gray-900 hover:bg-gray-800 dark:bg-gray-100 dark:hover:bg-white text-white dark:text-gray-900 font-medium rounded-xl transition-colors">
        Back to Measurements
    </a>
</div>
