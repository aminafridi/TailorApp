<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="TailorShop Management System — Premium Modern Interface" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} | " : "")TailorShop</title>
    
    <link rel="stylesheet" href="~/css/site.css" />
    
    <!-- Tailwind CSS Play CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Tailwind Configuration -->
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    },
                    colors: {
                        primary: {
                            50: 'var(--primary-50)',
                            100: 'var(--primary-100)',
                            400: 'var(--primary-400)',
                            500: 'var(--primary-500)',
                            600: 'var(--primary-600)',
                            700: 'var(--primary-700)',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Theme, Color, and Layout Initialization Logic -->
    <style>
        /* Layout Switcher Styles */
        body.layout-sidebar #top-navbar { display: none; }
        body.layout-sidebar #side-navbar { display: flex; }
        body.layout-sidebar #main-wrapper { flex-direction: row; }
        
        body.layout-topbar #side-navbar { display: none; }
        body.layout-topbar #top-navbar { display: block; }
        body.layout-topbar #main-wrapper { flex-direction: column; }
        
        /* Always enforce topbar logic on mobile screens */
        @@media (max-width: 768px) {
            body.layout-sidebar #side-navbar { display: none !important; }
            body.layout-sidebar #top-navbar { display: block !important; }
            body.layout-sidebar #main-wrapper { flex-direction: column !important; }
        }
    </style>
    <script>
        const palettes = {
            gold: { 50: '#fefce8', 100: '#fef9c3', 400: '#facc15', 500: '#eab308', 600: '#ca8a04', 700: '#a16207' },
            blue: { 50: '#eff6ff', 100: '#dbeafe', 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 700: '#1d4ed8' },
            green: { 50: '#f0fdf4', 100: '#dcfce7', 400: '#4ade80', 500: '#22c55e', 600: '#16a34a', 700: '#15803d' }
        };

        function applyTheme(theme) {
            if (theme === 'dark') document.documentElement.classList.add('dark');
            else document.documentElement.classList.remove('dark');
        }

        function applyColor(color) {
            const palette = palettes[color] || palettes.gold;
            const root = document.documentElement;
            root.style.setProperty('--primary-50', palette[50]);
            root.style.setProperty('--primary-100', palette[100]);
            root.style.setProperty('--primary-400', palette[400]);
            root.style.setProperty('--primary-500', palette[500]);
            root.style.setProperty('--primary-600', palette[600]);
            root.style.setProperty('--primary-700', palette[700]);
        }
        
        function applyLayout(layout) {
            document.documentElement.setAttribute('data-layout', layout);
        }

        const savedTheme = localStorage.getItem('theme') || 'dark';
        const savedColor = localStorage.getItem('color') || 'gold';
        const savedLayout = localStorage.getItem('layout') || 'topbar';
        
        applyTheme(savedTheme);
        applyColor(savedColor);
    </script>
</head>
<body class="bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 min-h-screen font-sans transition-colors duration-200 antialiased selection:bg-primary-500 selection:text-white">
    <script>
        // Apply layout class to body early to prevent flash
        document.body.classList.add('layout-' + (localStorage.getItem('layout') || 'topbar'));
    </script>
    
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div id="main-wrapper" class="flex min-h-screen w-full">
            
            <!-- SIDEBAR NAV -->
            <aside id="side-navbar" class="w-64 flex-col border-r border-gray-200 dark:border-gray-800 bg-slate-50 dark:bg-slate-950 shadow-sm z-40 sticky top-0 h-screen">
                <div class="h-16 flex items-center px-6 border-b border-gray-200 dark:border-gray-800 shrink-0">
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group">
                        <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-gradient-to-br from-primary-400 to-primary-600 text-white shadow-md">
                            <span class="text-lg leading-none">✂</span>
                        </div>
                        <span class="font-serif font-bold text-xl tracking-tight text-gray-900 dark:text-white">TailorShop</span>
                    </a>
                </div>
                
                <div class="flex-1 py-6 px-4 space-y-2 overflow-y-auto">
                    <p class="px-2 text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-4">Main Menu</p>
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-gray-100 dark:border-slate-800" : "text-slate-600 dark:text-slate-400 hover:bg-white/50 dark:hover:bg-slate-900/50 hover:text-slate-900 dark:hover:text-slate-200")">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-75" viewBox="0 0 20 20" fill="currentColor"><path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z" /></svg>
                        Dashboard
                    </a>
                    <a asp-controller="Customers" asp-action="Index" class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "bg-white dark:bg-slate-900 text-primary-600 dark:text-primary-400 shadow-sm border border-gray-100 dark:border-slate-800" : "text-slate-600 dark:text-slate-400 hover:bg-white/50 dark:hover:bg-slate-900/50 hover:text-slate-900 dark:hover:text-slate-200")">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 opacity-75" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z" /></svg>
                        Customers
                    </a>
                </div>
                
                <div class="p-4 border-t border-gray-200 dark:border-gray-800 shrink-0 space-y-4 bg-slate-100/50 dark:bg-slate-900/30">
                    <div class="flex items-center gap-3 px-1">
                        <span class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary-400 to-primary-600 text-white flex items-center justify-center text-sm font-bold shadow-md">
                            @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                        </span>
                        <div class="flex flex-col overflow-hidden">
                            <span class="text-sm font-bold text-slate-900 dark:text-slate-100 truncate">@User.Identity.Name</span>
                            <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest">Administrator</span>
                        </div>
                    </div>
                    <div class="flex gap-2">
                        <a asp-controller="Settings" asp-action="Index" class="h-11 flex-1 flex justify-center items-center bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl text-slate-500 hover:text-primary-600 dark:text-slate-400 dark:hover:text-primary-400 transition-all shadow-sm group" title="Settings">
                            <span class="group-hover:rotate-45 transition-transform duration-300 text-lg">⚙️</span>
                        </a>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="flex-1 m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="h-11 w-full flex justify-center items-center bg-rose-50 dark:bg-rose-950/30 border border-rose-100 dark:border-rose-900/30 rounded-xl text-rose-500 hover:bg-rose-100 dark:hover:bg-rose-900/40 transition-all shadow-sm group" title="Logout">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 3a1 1 0 00-1 1v12a1 1 0 102 0V4a1 1 0 00-1-1zm10.293 9.293a1 1 0 001.414 1.414l3-3a1 1 0 000-1.414l-3-3a1 1 0 10-1.414 1.414L14.586 9H7a1 1 0 100 2h7.586l-1.293 1.293z" clip-rule="evenodd" /></svg>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>
            
            <!-- CONTENT COLUMN -->
            <div class="flex-1 flex flex-col min-w-0 h-screen overflow-y-auto">
                
                <!-- TOP NAV (Hidden in sidebar mode) -->
                <nav id="top-navbar" class="sticky top-0 z-30 w-full border-b border-gray-200 dark:border-gray-800 bg-slate-50/80 dark:bg-slate-950/80 backdrop-blur-md shrink-0">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        <div class="flex justify-between h-16 items-center">
                            
                            <!-- Left: Brand -->
                            <div class="flex items-center gap-8">
                                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group">
                                    <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-gradient-to-br from-primary-400 to-primary-600 text-white shadow-lg shadow-primary-500/30 group-hover:shadow-primary-500/50 transition-all duration-300">
                                        <span class="text-xl">✂</span>
                                    </div>
                                    <span class="font-serif font-bold text-xl tracking-tight hidden sm:block text-gray-900 dark:text-white">TailorShop</span>
                                </a>

                                <!-- Desktop Nav Links -->
                                <div class="hidden md:flex space-x-1">
                                    <a asp-controller="Home" asp-action="Index" 
                                       class="px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "bg-primary-50 text-primary-700 dark:bg-primary-900/20 dark:text-primary-400" : "text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800/50 dark:hover:text-gray-200")">
                                        Dashboard
                                    </a>
                                    <a asp-controller="Customers" asp-action="Index" 
                                       class="px-4 py-2 rounded-lg text-sm font-medium transition-colors duration-200 @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "bg-primary-50 text-primary-700 dark:bg-primary-900/20 dark:text-primary-400" : "text-gray-600 hover:bg-gray-100 dark:text-gray-400 dark:hover:bg-gray-800/50 dark:hover:text-gray-200")">
                                        Customers
                                    </a>
                                </div>
                            </div>

                            <!-- Right: Profile & Settings -->
                            <div class="flex items-center gap-3">
                                <div class="hidden sm:flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-gray-900 px-3 py-1.5 rounded-full border border-gray-200 dark:border-gray-800">
                                    <span class="w-5 h-5 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold">
                                        @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                    </span>
                                    @User.Identity.Name
                                </div>
                                
                                <a asp-controller="Settings" asp-action="Index" class="p-2 rounded-lg text-gray-500 hover:text-gray-700 hover:bg-gray-100 dark:text-gray-400 dark:hover:text-gray-200 dark:hover:bg-gray-800 transition-colors" title="Settings">
                                    ⚙️
                                </a>

                                <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-4 py-2 text-sm font-medium rounded-lg text-red-600 bg-red-50 hover:bg-red-100 dark:text-red-400 dark:bg-red-900/20 dark:hover:bg-red-900/40 transition-colors flex items-center gap-1">
                                        Logout
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                    
                    <!-- Mobile Nav (Visible only on small screens) -->
                    <div class="md:hidden border-t border-gray-200 dark:border-gray-800 flex justify-around p-2 bg-gray-50/80 dark:bg-gray-950/80 backdrop-blur-md">
                        <a asp-controller="Home" asp-action="Index" class="flex-1 text-center py-2 text-sm font-medium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "text-primary-600 dark:text-primary-400" : "text-gray-500 dark:text-gray-400")">Dashboard</a>
                        <a asp-controller="Customers" asp-action="Index" class="flex-1 text-center py-2 text-sm font-medium @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "text-primary-600 dark:text-primary-400" : "text-gray-500 dark:text-gray-400")">Customers</a>
                    </div>
                </nav>

                <!-- Main Content Area -->
                <main class="flex-1 w-full max-w-7xl mx-auto p-4 sm:p-6 lg:p-8 shrink-0">
                    
                    <!-- Global Success Alert -->
                    @if (TempData["Success"] != null)
                    {
                        <div id="alert-success" class="mb-6 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-400 px-4 py-3 rounded-xl flex items-center justify-between shadow-sm transition-opacity duration-300">
                            <div class="flex items-center gap-2">
                                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path></svg>
                                <span class="font-medium">@TempData["Success"]</span>
                            </div>
                            <button onclick="document.getElementById('alert-success').style.opacity = '0'; setTimeout(() => document.getElementById('alert-success').remove(), 300);" class="text-green-500 hover:text-green-800 dark:hover:text-green-200">
                                ✕
                            </button>
                        </div>
                        <script>
                            setTimeout(() => {
                                const alert = document.getElementById('alert-success');
                                if (alert) { alert.style.opacity = '0'; setTimeout(() => alert.remove(), 300); }
                            }, 4000);
                        </script>
                    }

                    @RenderBody()
                </main>

                <!-- Footer -->
                <footer class="mt-auto border-t border-gray-200 dark:border-gray-800 py-6 bg-white dark:bg-gray-950 shrink-0">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-gray-500 dark:text-gray-400">
                        &copy; @DateTime.Now.Year <span class="font-serif">TailorShop Management System</span>. Premium Edition.
                    </div>
                </footer>

            </div>
        </div>
    }
    else
    {
        <!-- Unauthenticated Main Content Area -->
        <main class="flex-1 w-full flex items-center justify-center p-4">
            @RenderBody()
        </main>
    }

    <!-- Global Confirmation Modal (SweetAlert Style) -->
    <div id="confirm-modal" class="fixed inset-0 z-[100] hidden flex items-center justify-center p-4" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <!-- Dark Overlay Backdrop -->
        <div class="fixed inset-0 transition-opacity bg-gray-900/40 backdrop-blur-sm" aria-hidden="true" onclick="hideConfirmModal()"></div>

        <!-- Modal content: SweetAlert Style -->
        <div class="relative bg-white dark:bg-gray-900 rounded-xl text-center overflow-hidden shadow-2xl transform transition-all sm:max-w-md w-full border border-gray-100 dark:border-gray-800 p-8">
            <!-- Icon -->
            <div class="mx-auto flex items-center justify-center h-24 w-24 rounded-full border-4 border-orange-100 dark:border-orange-900/30 mb-4">
                <span class="text-5xl text-orange-400 font-serif">!</span>
            </div>
            
            <!-- Title & Message -->
            <h3 class="text-3xl font-bold text-gray-700 dark:text-gray-200 mb-2" id="confirm-modal-title">Attention</h3>
            <p class="text-lg text-gray-500 dark:text-gray-400 mb-8" id="confirm-modal-message">Are you sure you want to proceed?</p>
            
            <!-- Buttons -->
            <div class="flex justify-center gap-3">
                <button id="confirm-modal-button" type="button" class="px-6 py-2.5 bg-[#2ecb99] hover:bg-[#28b388] text-white font-semibold rounded-md shadow-sm transition-colors min-w-[120px]">
                    Yes, Delete it!
                </button>
                <button type="button" onclick="hideConfirmModal()" class="px-6 py-2.5 bg-[#f27474] hover:bg-[#e66363] text-white font-semibold rounded-md shadow-sm transition-colors min-w-[120px]">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <script>
        let currentConfirmCallback = null;

        function showConfirmModal(title, message, confirmText, callback) {
            document.getElementById('confirm-modal-title').innerText = title || 'Attention';
            document.getElementById('confirm-modal-message').innerText = message;
            document.getElementById('confirm-modal-button').innerText = confirmText || 'Yes, Delete it!';
            
            currentConfirmCallback = callback;
            
            const modal = document.getElementById('confirm-modal');
            modal.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
        }

        function hideConfirmModal() {
            const modal = document.getElementById('confirm-modal');
            modal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
            currentConfirmCallback = null;
        }

        document.getElementById('confirm-modal-button').addEventListener('click', function() {
            if (currentConfirmCallback) {
                currentConfirmCallback();
            }
            hideConfirmModal();
        });

        // Close on ESC
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') hideConfirmModal();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
