@model TailorApp.Models.PagedResult<TailorApp.Models.Customer>
@{
    ViewData["Title"] = "Customers Directory";
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-serif font-bold text-gray-900 dark:text-gray-50 tracking-tight">Customers Directory</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-1 text-sm">Manage your clients and their measurement profiles.</p>
    </div>
    <div>
        <a asp-controller="Customers" asp-action="Create" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-medium text-sm rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-primary-500/50 transform hover:-translate-y-0.5 transition-all duration-200">
            <span class="text-lg leading-none">+</span> Add Customer
        </a>
    </div>
</div>

@if (!Model.Items.Any())
{
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-12 text-center max-w-2xl mx-auto mt-8 shadow-sm">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gray-50 dark:bg-gray-800 text-gray-400 mb-4">
            <span class="text-3xl">👥</span>
        </div>
        @if (!string.IsNullOrEmpty(ViewBag.Search))
        {
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">No results found</h2>
            <p class="text-gray-500 dark:text-gray-400 mb-6">We couldn't find any customers matching "@ViewBag.Search".</p>
            <a asp-action="Index" class="text-primary-600 hover:text-primary-700 dark:text-primary-400 font-medium">Clear search</a>
        }
        else
        {
            <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">No customers yet</h2>
            <p class="text-gray-500 dark:text-gray-400 mb-6">Your customer directory is empty. Add your first customer to get started.</p>
            <a asp-action="Create" class="inline-flex items-center px-6 py-3 bg-gray-900 hover:bg-gray-800 dark:bg-gray-100 dark:hover:bg-white text-white dark:text-gray-900 font-medium rounded-xl transition-colors">
                Add First Customer
            </a>
        }
    </div>
}
else
{
    <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm overflow-hidden">
        <!-- Top Pagination Controls -->
        <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-800 bg-gray-50/50 dark:bg-gray-950/20 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-300">
                <span>Show</span>
                <select id="pageSizeSelect" onchange="window.location.href='?search=@(ViewBag.Search)&page=1&pageSize=' + this.value" class="bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-gray-100 rounded-md px-2 py-1.5 text-sm focus:ring-primary-500 focus:border-primary-500 outline-none">
                    @Html.Raw(Model.PageSize == 50 ? "<option value=\"50\" selected>50</option>" : "<option value=\"50\">50</option>")
                    @Html.Raw(Model.PageSize == 100 ? "<option value=\"100\" selected>100</option>" : "<option value=\"100\">100</option>")
                    @Html.Raw(Model.PageSize == 200 ? "<option value=\"200\" selected>200</option>" : "<option value=\"200\">200</option>")
                    @Html.Raw(Model.PageSize > 200 ? "<option value=\"-1\" selected>All</option>" : "<option value=\"-1\">All</option>")
                </select>
                <span>entries</span>
            </div>
            
            <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-300 w-full sm:w-auto">
                <span class="hidden sm:inline">Search:</span>
                <form method="get" class="relative flex-1 sm:w-64 m-0">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                        <span class="text-gray-400 text-sm">🔍</span>
                    </div>
                    <input type="text" name="search" value="@ViewBag.Search" 
                           class="w-full pl-10 pr-4 py-1.5 rounded-md border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition-colors text-sm" 
                           placeholder="" />
                    @if (!string.IsNullOrEmpty(ViewBag.Search))
                    {
                        <a asp-action="Index" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">✕</a>
                    }
                </form>
            </div>
        </div>
        
        <div class="overflow-x-auto">
            <table id="customersTable" class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 dark:bg-gray-950/50 border-b border-gray-200 dark:border-gray-800 text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold">
                        <th class="px-6 py-4 w-16 text-center">#</th>
                        <th class="px-6 py-4">Customer Name</th>
                        <th class="px-6 py-4">Register No.</th>
                        <th class="px-6 py-4">Mobile Contacts</th>
                        <th class="px-6 py-4 text-center">Measurements</th>
                        <th class="px-6 py-4 text-center">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="customersTableBody" class="divide-y divide-gray-200 dark:divide-gray-800">
                    @{ int rowNum = Model.TotalCount == 0 ? 1 : ((Model.Page - 1) * Model.PageSize) + 1; }
                    @foreach (var c in Model.Items)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors group">
                            <td class="px-6 py-4 text-center text-sm text-gray-500 dark:text-gray-400 font-medium">
                                @(rowNum++)
                            </td>
                            <td class="px-6 py-4">
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@c.CustomerID" class="flex items-center gap-3 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                                    <div class="w-10 h-10 rounded-full bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-400 flex items-center justify-center font-bold text-sm border border-primary-200 dark:border-primary-800/50">
                                        @c.CustomerName[0].ToString().ToUpper()
                                    </div>
                                    <span class="font-medium text-gray-900 dark:text-gray-100">@c.CustomerName</span>
                                </a>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm font-medium text-gray-900 dark:text-gray-100">
                                    @if (!string.IsNullOrEmpty(c.RegisterNo))
                                    {
                                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300 border border-gray-200 dark:border-gray-700">
                                            @c.RegisterNo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400 italic text-xs">N/A</span>
                                    }
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm text-gray-700 dark:text-gray-300">
                                    @if (!string.IsNullOrEmpty(c.MobileNo1)) { <div>@c.MobileNo1</div> }
                                    @if (!string.IsNullOrEmpty(c.MobileNo2)) { <div class="text-gray-400">@c.MobileNo2</div> }
                                    @if (string.IsNullOrEmpty(c.MobileNo1) && string.IsNullOrEmpty(c.MobileNo2)) { <span class="text-gray-400 italic">No contact</span> }
                                </div>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-400 border border-blue-200 dark:border-blue-800/50">
                                    @c.TotalMeasurements 📐
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (c.Status)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400 border border-green-200 dark:border-green-800/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span> Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400 border border-red-200 dark:border-red-800/50">
                                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span> Inactive
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 text-right text-sm font-medium">
                                <div class="flex justify-end gap-1.5">
                                    <a asp-action="Details" asp-route-id="@c.CustomerID" class="px-3 py-1.5 text-xs font-semibold rounded shadow-sm text-white bg-blue-500 hover:bg-blue-600 transition-colors flex items-center gap-1" title="View Profile">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z" /><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" /></svg>
                                        View
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.CustomerID" class="px-3 py-1.5 text-xs font-semibold rounded shadow-sm text-white bg-amber-500 hover:bg-amber-600 transition-colors flex items-center gap-1" title="Edit Customer">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg>
                                        Edit
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@c.CustomerID" method="post" class="m-0 inline-block" onsubmit="return confirm('Are you sure you want to permanently delete @c.CustomerName?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="px-3 py-1.5 text-xs font-semibold rounded shadow-sm text-white bg-red-500 hover:bg-red-600 transition-colors flex items-center gap-1" title="Delete Customer">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Pagination Controls -->
        <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950/50 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="text-sm text-gray-500 dark:text-gray-400">
                @{
                    int startRecord = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
                    int endRecord = Math.Min(Model.Page * Model.PageSize, Model.TotalCount);
                    if (Model.PageSize > 200) endRecord = Model.TotalCount;
                }
                Showing <span class="font-medium text-gray-900 dark:text-white">@startRecord</span> to <span class="font-medium text-gray-900 dark:text-white">@endRecord</span> of <span class="font-medium text-gray-900 dark:text-white">@Model.TotalCount</span> entries
            </div>

            <div class="flex items-center gap-1">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" class="px-3 py-1.5 border border-gray-300 dark:border-gray-700 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                        Previous
                    </a>
                }
                else
                {
                    <button disabled class="px-3 py-1.5 border border-gray-300 dark:border-gray-700 rounded-md text-sm font-medium text-gray-400 dark:text-gray-600 bg-gray-100 dark:bg-gray-800 cursor-not-allowed transition-colors">
                        Previous
                    </button>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-search="@ViewBag.Search" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" class="px-3 py-1.5 border border-gray-300 dark:border-gray-700 rounded-md text-sm font-medium text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                        Next
                    </a>
                }
                else
                {
                    <button disabled class="px-3 py-1.5 border border-gray-300 dark:border-gray-700 rounded-md text-sm font-medium text-gray-400 dark:text-gray-600 bg-gray-100 dark:bg-gray-800 cursor-not-allowed transition-colors">
                        Next
                    </button>
                }
            </div>
        </div>
    </div>
}
