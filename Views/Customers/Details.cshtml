@model TailorApp.Models.Customer
@{ 
    ViewData["Title"] = Model.CustomerName;
    var sizes = ViewBag.Sizes as List<TailorApp.Models.Size> ?? new();
}

<!-- Header -->
<div class="mb-8">
    <a asp-controller="Customers" asp-action="Index" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400 mb-4 transition-colors">
        <span class="mr-1">←</span> Back to Directory
    </a>
    <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
        <div class="flex items-center gap-4">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary-400 to-primary-600 text-white flex items-center justify-center text-3xl font-bold shadow-lg shadow-primary-500/30">
                @Model.CustomerName[0].ToString().ToUpper()
            </div>
            <div>
                <h1 class="text-3xl font-serif font-bold text-gray-900 dark:text-white">@Model.CustomerName</h1>
                <p class="text-gray-500 dark:text-gray-400 mt-1">Customer ID: #@Model.CustomerID</p>
            </div>
        </div>
        <div class="flex flex-wrap gap-3">
            <a asp-controller="Customers" asp-action="Edit" asp-route-id="@Model.CustomerID" class="inline-flex items-center justify-center gap-2 px-4 py-2 border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-900 hover:bg-gray-50 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium rounded-xl transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg> Edit Profile
            </a>
            <a asp-controller="Sizes" asp-action="Create" asp-route-customerId="@Model.CustomerID" class="inline-flex items-center justify-center gap-2 px-5 py-2.5 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-medium rounded-xl shadow-lg shadow-primary-500/30 transition-colors">
                <span class="text-lg leading-none">+</span> Add Measurement
            </a>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Left Column: Customer Profile -->
    <div class="lg:col-span-1 space-y-6">
        <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
                <span>👤</span> Contact Information
            </h2>
            
            <div class="space-y-5">
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Status</p>
                    @if (Model.Status)
                    {
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400 border border-green-200 dark:border-green-800/50">
                            <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span> Active Account
                        </span>
                    }
                    else
                    {
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-red-50 text-red-700 dark:bg-red-900/20 dark:text-red-400 border border-red-200 dark:border-red-800/50">
                            <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span> Inactive
                        </span>
                    }
                </div>

                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Primary Mobile</p>
                    <p class="text-gray-900 dark:text-gray-100 font-medium">@(Model.MobileNo1 ?? "—")</p>
                </div>
                
                <div>
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Secondary Mobile</p>
                    <p class="text-gray-900 dark:text-gray-100 font-medium">@(Model.MobileNo2 ?? "—")</p>
                </div>
                
                <div class="pt-4 border-t border-gray-100 dark:border-gray-800">
                    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 mb-1">Total Records</p>
                    <p class="text-2xl font-bold text-gray-900 dark:text-white">@sizes.Count</p>
                </div>
            </div>
            
            <div class="mt-8 pt-6 border-t border-gray-100 dark:border-gray-800">
                <form id="delete-customer-form" asp-action="Delete" asp-route-id="@Model.CustomerID" method="post">
                    @Html.AntiForgeryToken()
                    <button type="button" 
                            onclick="showConfirmModal(null, 'Delete @Model.CustomerName and all measurements?', null, () => document.getElementById('delete-customer-form').submit())"
                            class="w-full py-2.5 px-4 bg-red-50 hover:bg-red-100 text-red-600 dark:bg-red-900/10 dark:hover:bg-red-900/20 dark:text-red-400 font-medium rounded-xl transition-colors flex justify-center items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" /></svg> Delete Customer
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Right Column: Measurements -->
    <div class="lg:col-span-2">
        <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm overflow-hidden flex flex-col h-full">
            <div class="p-6 border-b border-gray-200 dark:border-gray-800 flex justify-between items-center bg-gray-50/50 dark:bg-gray-950/50">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                    <span>📏</span> Measurement History
                </h2>
                <span class="text-sm text-gray-500 dark:text-gray-400">@sizes.Count records found</span>
            </div>

            @if (!sizes.Any())
            {
                <div class="flex-1 p-12 text-center flex flex-col items-center justify-center">
                    <div class="w-16 h-16 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-400 flex items-center justify-center text-3xl mb-4">
                        ✂
                    </div>
                    <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-2">No measurements yet</h3>
                    <p class="text-gray-500 dark:text-gray-400 mb-6 max-w-sm">This customer doesn't have any saved measurements. Record their first measurement to get started.</p>
                    <a asp-controller="Sizes" asp-action="Create" asp-route-customerId="@Model.CustomerID" class="px-5 py-2.5 bg-gray-900 hover:bg-gray-800 dark:bg-gray-100 dark:hover:bg-white text-white dark:text-gray-900 font-medium rounded-xl transition-colors">
                        Add First Measurement
                    </a>
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-50 dark:bg-gray-950/30 text-xs uppercase tracking-wider text-gray-500 dark:text-gray-400 font-semibold border-b border-gray-200 dark:border-gray-800">
                                <th class="px-6 py-4">RegisterNo</th>
                                <th class="px-6 py-4">Core Dimensions</th>
                                <th class="px-6 py-4">Style</th>
                                <th class="px-6 py-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
                            @foreach (var s in sizes)
                            {
                                <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors group">
                                    <td class="px-6 py-4">
                                        <span class="inline-flex items-center px-3 py-1 rounded-lg text-sm font-bold font-mono bg-gradient-to-r from-indigo-500 via-purple-500 to-pink-500 text-white shadow-md shadow-purple-500/20 tracking-wider">
                                            @s.RegisterNo
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="flex flex-wrap gap-2 text-xs">
                                            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded-md text-gray-700 dark:text-gray-300">L: <span class="font-bold">@s.Lambai</span></span>
                                            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded-md text-gray-700 dark:text-gray-300">T: <span class="font-bold">@s.Tera</span></span>
                                            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-800 rounded-md text-gray-700 dark:text-gray-300">C: <span class="font-bold">@s.Chati</span></span>
                                        </div>
                                    </td>
                                    <td class="px-6 py-4">
                                        <div class="text-sm text-gray-600 dark:text-gray-400 truncate max-w-[200px]">
                                            @if (!string.IsNullOrEmpty(s.Design)) { @s.Design } else { <span class="italic text-gray-400">Standard</span> }
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 text-right">
                                        <div class="flex justify-end gap-1.5">
                                            <button type="button" 
                                                    onclick="openMeasurementModal(@s.SizeID)"
                                                    class="px-3 py-1.5 text-xs font-semibold rounded shadow-sm text-white bg-blue-500 hover:bg-blue-600 transition-colors flex items-center gap-1" title="View Full Details">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M10 12a2 2 0 100-4 2 2 0 000 4z" /><path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" /></svg> View
                                            </button>
                                            <a asp-controller="Sizes" asp-action="Edit" asp-route-id="@s.SizeID" class="px-3 py-1.5 text-xs font-semibold rounded shadow-sm text-white bg-amber-500 hover:bg-amber-600 transition-colors flex items-center gap-1" title="Edit Measurement">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg> Edit
                                            </a>
                                            <form id="delete-size-@s.SizeID" asp-controller="Sizes" asp-action="Delete" asp-route-id="@s.SizeID" asp-route-customerId="@Model.CustomerID" method="post" class="m-0 inline-block">
                                                @Html.AntiForgeryToken()
                                                <button type="button" 
                                                        onclick="showConfirmModal(null, 'Delete measurement record #@s.RegisterNo?', null, () => document.getElementById('delete-size-@s.SizeID').submit())"
                                                        class="px-3 py-1.5 text-xs font-semibold rounded shadow-sm text-white bg-red-500 hover:bg-red-600 transition-colors flex items-center gap-1" title="Delete Measurement">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" /></svg>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

<!-- Measurement Details Modal -->
<div id="size-modal" class="fixed inset-0 z-[110] hidden flex items-center justify-center p-4 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 transition-opacity bg-gray-950/40 backdrop-blur-md" aria-hidden="true" onclick="closeMeasurementModal()"></div>
    
    <div class="relative bg-white dark:bg-gray-900 rounded-3xl text-left overflow-hidden shadow-2xl transform transition-all sm:max-w-4xl w-full border border-gray-100 dark:border-gray-800 animate-in fade-in zoom-in duration-300">
        <!-- Close Button -->
        <button onclick="closeMeasurementModal()" class="absolute top-4 right-4 sm:top-5 sm:right-5 text-gray-400 hover:text-gray-600 dark:hover:text-white transition-colors z-10 p-2 hover:bg-gray-100 dark:hover:bg-gray-800 rounded-full bg-white/80 dark:bg-gray-900/80 backdrop-blur-sm">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <div id="size-modal-content" class="p-4 pt-14 sm:p-8">
            <!-- Loading State -->
            <div id="size-modal-loader" class="flex flex-col items-center justify-center py-20 space-y-4">
                <div class="w-12 h-12 border-4 border-primary-500 border-t-transparent rounded-full animate-spin"></div>
                <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Loading measurement details...</p>
            </div>
            
            <div id="size-modal-body" class="hidden">
                <!-- Content will be injected here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openMeasurementModal(id) {
            const modal = document.getElementById('size-modal');
            const body = document.getElementById('size-modal-body');
            const loader = document.getElementById('size-modal-loader');
            
            modal.classList.remove('hidden');
            body.classList.add('hidden');
            loader.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');
            
            fetch(`/Sizes/DetailsPartial/${id}`)
                .then(response => response.text())
                .then(html => {
                    body.innerHTML = html;
                    loader.classList.add('hidden');
                    body.classList.remove('hidden');
                })
                .catch(err => {
                    console.error('Error loading details:', err);
                    body.innerHTML = '<div class="text-red-500 text-center py-10">Error loading details. Please try again.</div>';
                    loader.classList.add('hidden');
                    body.classList.remove('hidden');
                });
        }

        function closeMeasurementModal() {
            const modal = document.getElementById('size-modal');
            modal.classList.add('hidden');
            document.body.classList.remove('overflow-hidden');
        }

        // Close on ESC
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeMeasurementModal();
        });
    </script>
}
