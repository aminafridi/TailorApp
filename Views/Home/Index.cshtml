@model TailorApp.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
        <h1 class="text-3xl font-serif font-bold text-gray-900 dark:text-gray-50 tracking-tight">Dashboard</h1>
        <p class="text-gray-500 dark:text-gray-400 mt-1 text-sm">Welcome back to your tailoring management center.</p>
    </div>
    <div class="flex gap-3">
        <a asp-controller="Customers" asp-action="Create" class="inline-flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-medium rounded-xl shadow-lg shadow-primary-500/30 hover:shadow-primary-500/50 transform hover:-translate-y-0.5 transition-all duration-200">
            <span class="text-xl leading-none">+</span> Add Customer
        </a>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <!-- Total Customers Card -->
    <a asp-controller="Customers" asp-action="Index" class="group bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-primary-200 dark:hover:border-primary-900 transition-all duration-300 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transform group-hover:scale-110 transition-all duration-300">
            <span class="text-6xl text-primary-500">👥</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 font-medium text-sm mb-2">Total Customers</h3>
        <p class="text-4xl font-bold text-gray-900 dark:text-white">@Model.TotalCustomers</p>
        <div class="mt-4 flex items-center text-sm font-medium text-primary-600 dark:text-primary-400">
            <span>View Directory</span>
            <span class="ml-1 group-hover:translate-x-1 transition-transform">→</span>
        </div>
    </a>

    <!-- Total Measurements Card -->
    <div class="group bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-primary-200 dark:hover:border-primary-900 transition-all duration-300 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-6 opacity-10 group-hover:opacity-20 transform group-hover:scale-110 transition-all duration-300">
            <span class="text-6xl text-primary-500">📏</span>
        </div>
        <h3 class="text-gray-500 dark:text-gray-400 font-medium text-sm mb-2">Recorded Measurements</h3>
        <p class="text-4xl font-bold text-gray-900 dark:text-white">@Model.TotalMeasurements</p>
        <div class="mt-4 flex items-center text-sm font-medium text-gray-400">
            Across all customers
        </div>
    </div>
</div>

<div class="mt-12 bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl p-8 text-center max-w-2xl mx-auto">
    <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 mb-4">
        <span class="text-2xl">✨</span>
    </div>
    <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Ready to work?</h2>
    <p class="text-gray-500 dark:text-gray-400 mb-6">Search for an existing customer or register a new one to record their measurements.</p>
    
    <form asp-controller="Customers" asp-action="Index" method="get" class="flex max-w-md mx-auto relative">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <span class="text-gray-400">🔍</span>
        </div>
        <input type="text" name="search" class="w-full pl-10 pr-4 py-3 rounded-l-xl border border-r-0 border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-white focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-all" placeholder="Search customers by name..." />
        <button type="submit" class="px-6 py-3 bg-gray-900 hover:bg-gray-800 dark:bg-gray-100 dark:hover:bg-white text-white dark:text-gray-900 font-medium rounded-r-xl transition-colors">
            Search
        </button>
    </form>
</div>
