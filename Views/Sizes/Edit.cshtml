                                <td class="py-0 px-1.5 lg:py-1 lg:px-3 border-r border-gray-200 dark:border-gray-800/30 relative">
                                    <input asp-for="Ghera" inputmode="decimal" class="w-full text-left font-black text-sm lg:text-xl bg-transparent border-none focus:ring-0 p-0 text-gray-900 dark:text-white h-6 lg:h-9 focus:bg-indigo-50/50 dark:focus:bg-indigo-950/25 rounded-md font-mono" placeholder="--" dir="ltr" />
                                    <span asp-validation-for="Ghera" class="text-red-500 text-[8px] absolute bottom-0 left-1 lg:left-3"></span>
