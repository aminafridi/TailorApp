                                <td class="py-1 px-1.5 lg:py-3 lg:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-xs lg:text-lg select-none" dir="rtl">دامن</td>
                            </tr>
                            <tr class="hover:bg-white dark:hover:bg-gray-800/10 transition-colors">
                                <td class="py-0 px-1.5 lg:py-1 lg:px-3 border-r border-gray-200 dark:border-gray-800/30 relative">
                                    <input asp-for="ShalwarLambai" inputmode="decimal" class="w-full text-left font-black text-sm lg:text-xl bg-transparent border-none focus:ring-0 p-0 text-gray-900 dark:text-white h-6 lg:h-9 focus:bg-indigo-50/50 dark:focus:bg-indigo-950/25 rounded-md font-mono" placeholder="--" dir="ltr" />
                                    <span asp-validation-for="ShalwarLambai" class="text-red-500 text-[8px] absolute bottom-0 left-1 lg:left-3"></span>
                                </td>
                                <td class="py-1 px-1.5 lg:py-3 lg:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-xs lg:text-lg select-none" dir="rtl">شلوار</td>
                            </tr>
                            <tr class="hover:bg-white dark:hover:bg-gray-800/10 transition-colors">
                                <td class="py-0 px-1.5 lg:py-1 lg:px-3 border-r border-gray-200 dark:border-gray-800/30 relative">
                                    <input asp-for="Pancha" inputmode="decimal" class="w-full text-left font-black text-sm lg:text-xl bg-transparent border-none focus:ring-0 p-0 text-gray-900 dark:text-white h-6 lg:h-9 focus:bg-indigo-50/50 dark:focus:bg-indigo-950/25 rounded-md font-mono" placeholder="--" dir="ltr" />
                                    <span asp-validation-for="Pancha" class="text-red-500 text-[8px] absolute bottom-0 left-1 lg:left-3"></span>
