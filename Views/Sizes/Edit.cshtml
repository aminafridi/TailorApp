        <!-- Design Notes & Other Details - Full Width Below Both Columns (Visible ONLY on mobile) -->
        <div class="col-span-12 mt-2 lg:hidden">
            <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-xl shadow-sm p-3">
                <div class="grid grid-cols-1 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-400 dark:text-gray-500 mb-1">Design Notes</label>
                        <textarea id="DesignNotesMobile" name="Design" class="w-full px-3 py-2 text-xs rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 resize-none transition-all h-16 leading-normal" placeholder="Specify design details, styles, cuts...">@Model.Design</textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-400 dark:text-gray-500 mb-1">Other Details</label>
                        <textarea id="OtherDetailsMobile" name="OtherDetails" class="w-full px-3 py-2 text-xs rounded-lg border border-gray-300 dark:border-gray-700 bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100 focus:ring-2 focus:ring-primary-500 resize-none transition-all h-16 leading-normal" placeholder="Any additional instructions or measurements notes...">@Model.OtherDetails</textarea>
                    </div>
                </div>
            </div>
            
            <!-- Cancel and Save Buttons - Always Below Note Inputs on mobile -->
            <div class="flex gap-2 mt-2">
                <a asp-controller="Sizes" asp-action="Index" class="px-3 py-1 rounded-lg text-xs font-bold text-gray-700 bg-white border border-gray-300 hover:bg-gray-50 dark:bg-gray-900 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800 transition-colors shadow-sm text-center flex-1 h-7 flex items-center justify-center">
                    Cancel
                </a>
                <button type="submit" class="px-5 py-1 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-lg shadow transition-colors flex-1 text-center h-7 flex items-center justify-center gap-1">
                    <span>✓</span> Save
                </button>
            </div>
        </div>

    </div>
</form>

<script>
    // Sync function to enable/disable desktop vs mobile fields based on viewport width
    function syncInputs() {
        const isDesktop = window.innerWidth >= 1024;
        
        const dtDesign = document.getElementById('DesignNotesDesktop');
        const mbDesign = document.getElementById('DesignNotesMobile');
        const dtOther = document.getElementById('OtherDetailsDesktop');
        const mbOther = document.getElementById('OtherDetailsMobile');
        
        if (isDesktop) {
            if (dtDesign && mbDesign) {
                dtDesign.disabled = false;
                mbDesign.disabled = true;
                if (mbDesign.value && !dtDesign.value) dtDesign.value = mbDesign.value;
            }
            if (dtOther && mbOther) {
                dtOther.disabled = false;
                mbOther.disabled = true;
                if (mbOther.value && !dtOther.value) dtOther.value = mbOther.value;
            }
        } else {
            if (dtDesign && mbDesign) {
                dtDesign.disabled = true;
                mbDesign.disabled = false;
                if (dtDesign.value && !mbDesign.value) mbDesign.value = dtDesign.value;
            }
            if (dtOther && mbOther) {
                dtOther.disabled = true;
                mbOther.disabled = false;
                if (dtOther.value && !mbOther.value) mbOther.value = dtOther.value;
            }
        }
    }

    // Add event listeners for sync-on-type
    document.getElementById('DesignNotesDesktop')?.addEventListener('input', (e) => {
        const mb = document.getElementById('DesignNotesMobile');
        if (mb) mb.value = e.target.value;
    });
    document.getElementById('DesignNotesMobile')?.addEventListener('input', (e) => {
        const dt = document.getElementById('DesignNotesDesktop');
        if (dt) dt.value = e.target.value;
    });
    document.getElementById('OtherDetailsDesktop')?.addEventListener('input', (e) => {
        const mb = document.getElementById('OtherDetailsMobile');
        if (mb) mb.value = e.target.value;
    });
    document.getElementById('OtherDetailsMobile')?.addEventListener('input', (e) => {
        const dt = document.getElementById('OtherDetailsDesktop');
        if (dt) dt.value = e.target.value;
    });

    window.addEventListener('resize', syncInputs);

    // Handle Salai checkbox toggles
    document.querySelectorAll('.salai-checkbox').forEach(cb => {
        cb.addEventListener('change', function() {
            const dtEl = document.getElementById('OtherDetailsDesktop');
            const mbEl = document.getElementById('OtherDetailsMobile');
            
            [dtEl, mbEl].forEach(otherDetailsEl => {
                if(!otherDetailsEl) return;
                let text = otherDetailsEl.value || '';
                const val = this.value;
                
                if(this.checked) {
                    if(!text.includes(val)) {
                        text = text ? text + '، ' + val : val;
                    }
                } else {
                    // Remove it cleanly
                    const regex = new RegExp('(^|،\\s*)' + val + '(\\s*،)?', 'g');
                    text = text.replace(regex, function(match, p1, p2) {
                        if (p1 && p2) return '، ';
                        return '';
                    }).trim();
                    // clean up any trailing/leading comma
                    text = text.replace(/^،\s*/, '').replace(/،\s*$/, '');
                }
                otherDetailsEl.value = text;
                
                // Highlight the textarea briefly
                otherDetailsEl.classList.add('ring-2', 'ring-indigo-500');
                setTimeout(() => otherDetailsEl.classList.remove('ring-2', 'ring-indigo-500'), 300);
            });
        });
    });

    // Focus first measurement field on load and sync checkboxes
    document.addEventListener('DOMContentLoaded', () => {
        syncInputs();
        
        setTimeout(() => {
            const firstInput = document.getElementById('Lambai');
            if(firstInput) firstInput.focus();
        }, 100);
        
        // Sync checkboxes with initial OtherDetails text
        const otherDetailsEl = document.getElementById('OtherDetailsDesktop') || document.getElementById('OtherDetailsMobile');
        if(otherDetailsEl) {
            const currentText = otherDetailsEl.value || '';
            document.querySelectorAll('.salai-checkbox').forEach(cb => {
                if(currentText.includes(cb.value)) {
                    cb.checked = true;
                }
            });
        }
        
        // Allow clicking row to focus input
        document.querySelectorAll('tr').forEach(row => {
            row.addEventListener('click', (e) => {
                if(e.target.tagName !== 'INPUT') {
                    const input = row.querySelector('input');
                    if(input) input.focus();
                }
            });
        });
    });
</script>
