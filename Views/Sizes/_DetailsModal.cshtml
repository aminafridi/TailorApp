@model TailorApp.Models.Size

<div id="measurement-capture-card" class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 items-start p-1 bg-white dark:bg-gray-900 rounded-3xl border border-transparent">
    
    <!-- Measurements Slip (4 cols, Left on Desktop) -->
    <div class="lg:col-span-4 order-first lg:order-first">
        <div class="bg-[#fcfbf7] dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm overflow-hidden relative font-mono">
            <!-- Slip Header Pattern -->
            <div class="h-2 w-full bg-repeating-linear-gradient-to-r from-gray-300 to-gray-300 dark:from-gray-700 dark:to-gray-700" style="background-image: repeating-linear-gradient(90deg, transparent, transparent 4px, #ccc 4px, #ccc 8px);"></div>
            
            <div class="px-5 py-4 border-b border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-950/50 flex justify-between items-center">
                <h3 class="text-xl font-bold text-gray-800 dark:text-white flex items-center gap-2 uppercase tracking-widest">
                    <span>📏</span> Measurements
                </h3>
                <span class="text-[10px] text-gray-400 font-bold tracking-widest">INCHES</span>
            </div>
            
            <!-- Customer info on Slip -->
            <div class="px-5 py-3 border-b border-gray-100 dark:border-gray-800/60 bg-[#fefdfa]/80 dark:bg-gray-950/20 flex flex-wrap gap-x-4 gap-y-1.5 items-center justify-between text-xs font-sans">
                <div class="flex items-center gap-1.5">
                    <span class="text-gray-400 dark:text-gray-500 font-bold uppercase tracking-wider">Name:</span>
                    <span class="text-gray-900 dark:text-white font-bold text-[14px] urdu-text">
                        @Model.CustomerName
                    </span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="text-gray-400 dark:text-gray-500 font-bold uppercase tracking-wider">RegisterNo:</span>
                    <span class="text-gray-950 dark:text-gray-100 font-black font-mono text-[13px]">
                        @Model.RegisterNo
                    </span>
                </div>
            </div>
            
            <div class="p-0">
                <table class="w-full text-sm">
                    <tbody>
                        <tr class="border-b border-gray-100 dark:border-gray-800/50">
                            <td class="py-2 px-3 sm:px-5 font-bold text-xl text-gray-900 dark:text-white border-r border-gray-100 dark:border-gray-800/50 w-1/2">@(string.IsNullOrEmpty(Model.Lambai) ? "--" : Model.Lambai)</td>
                            <td class="py-3 px-3 sm:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-lg" dir="rtl">لمبائی</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800/50">
                            <td class="py-2 px-3 sm:px-5 font-bold text-xl text-gray-900 dark:text-white border-r border-gray-100 dark:border-gray-800/50">@(string.IsNullOrEmpty(Model.Bazo) ? "--" : Model.Bazo)</td>
                            <td class="py-3 px-3 sm:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-lg" dir="rtl">آستین</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800/50">
                            <td class="py-2 px-3 sm:px-5 font-bold text-xl text-gray-900 dark:text-white border-r border-gray-100 dark:border-gray-800/50">@(string.IsNullOrEmpty(Model.Tera) ? "--" : Model.Tera)</td>
                            <td class="py-3 px-3 sm:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-lg" dir="rtl">تیرا</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800/50">
                            <td class="py-2 px-3 sm:px-5 font-bold text-xl text-gray-900 dark:text-white border-r border-gray-100 dark:border-gray-800/50">@(string.IsNullOrEmpty(Model.Calar) ? "--" : Model.Calar)</td>
                            <td class="py-3 px-3 sm:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-lg" dir="rtl">کالر</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800/50">
                            <td class="py-2 px-3 sm:px-5 font-bold text-xl text-gray-900 dark:text-white border-r border-gray-100 dark:border-gray-800/50">@(string.IsNullOrEmpty(Model.Chati) ? "--" : Model.Chati)</td>
                            <td class="py-3 px-3 sm:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-lg" dir="rtl">چھاتی</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800/50">
                            <td class="py-2 px-3 sm:px-5 font-bold text-xl text-gray-900 dark:text-white border-r border-gray-100 dark:border-gray-800/50">@(string.IsNullOrEmpty(Model.Kamar) ? "--" : Model.Kamar)</td>
                            <td class="py-3 px-3 sm:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-lg" dir="rtl">کمر</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800/50">
                            <td class="py-2 px-3 sm:px-5 font-bold text-xl text-gray-900 dark:text-white border-r border-gray-100 dark:border-gray-800/50">@(string.IsNullOrEmpty(Model.Ghera) ? "--" : Model.Ghera)</td>
                            <td class="py-3 px-3 sm:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-lg" dir="rtl">دامن</td>
                        </tr>
                        <tr class="border-b border-gray-100 dark:border-gray-800/50">
                            <td class="py-2 px-3 sm:px-5 font-bold text-xl text-gray-900 dark:text-white border-r border-gray-100 dark:border-gray-800/50">@(string.IsNullOrEmpty(Model.ShalwarLambai) ? "--" : Model.ShalwarLambai)</td>
                            <td class="py-3 px-3 sm:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-lg" dir="rtl">شلوار</td>
                        </tr>
                        <tr>
                            <td class="py-2 px-3 sm:px-5 font-bold text-xl text-gray-900 dark:text-white border-r border-gray-100 dark:border-gray-800/50">@(string.IsNullOrEmpty(Model.Pancha) ? "--" : Model.Pancha)</td>
                            <td class="py-3 px-3 sm:px-5 font-bold text-gray-600 dark:text-gray-400 align-middle text-right urdu-text text-lg" dir="rtl">پانچہ</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Visual Options (8 cols, Right on Desktop) -->
    <div class="lg:col-span-8 space-y-6 order-last lg:order-last">
        
        <div class="bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-sm p-5 h-full">
            <h3 class="text-lg font-bold text-gray-500 dark:text-gray-400 mb-4 border-b border-gray-100 dark:border-gray-800 pb-2">Visual Details</h3>
            
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                
                <!-- Collar Type -->
                <div class="space-y-2">
                    <label class="block text-lg font-semibold text-gray-700 dark:text-gray-300 text-center urdu-text">کالر سٹائل</label>
                    <div class="p-3 rounded-xl border-2 border-primary-200 dark:border-primary-700 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-400 flex flex-col items-center justify-center h-20">
                        @if(Model.CalarType == 1) {
                            <svg class="w-8 h-8 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 6l8 4 8-4M4 6v4l8 4 8-4V6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span class="text-sm font-bold urdu-text">کالر</span>
                        } else if(Model.CalarType == 2) {
                            <svg class="w-8 h-8 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8c0-2 4-3 6-3s6 1 6 3v2c0 2-4 3-6 3s-6-1-6-3V8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span class="text-sm font-bold urdu-text">بین</span>
                        } else {
                            <span class="text-sm font-bold text-gray-400 urdu-text">--</span>
                        }
                    </div>
                    @if(!string.IsNullOrEmpty(Model.CalarDetail)) {
                        <div class="w-full mt-2 px-2 py-1.5 text-sm rounded-lg bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 text-center urdu-text border border-gray-200 dark:border-gray-700">@Model.CalarDetail</div>
                    }
                </div>

                <!-- Sleeve Type -->
                <div class="space-y-2">
                    <label class="block text-lg font-semibold text-gray-700 dark:text-gray-300 text-center urdu-text">آستین سٹائل</label>
                    <div class="p-3 rounded-xl border-2 border-primary-200 dark:border-primary-700 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-400 flex flex-col items-center justify-center h-20">
                        @if(Model.BazoType == 1) {
                            <svg class="w-8 h-8 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 4h8l-2 16h-4L8 4z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span class="text-sm font-bold urdu-text">گول بازو</span>
                        } else if(Model.BazoType == 2) {
                            <svg class="w-8 h-8 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 4h8l-2 12h2v4H6v-4h2L8 4z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span class="text-sm font-bold urdu-text">کف</span>
                        } else {
                            <span class="text-sm font-bold text-gray-400 urdu-text">--</span>
                        }
                    </div>
                    @if(!string.IsNullOrEmpty(Model.BazoDetail)) {
                        <div class="w-full mt-2 px-2 py-1.5 text-sm rounded-lg bg-gray-50 dark:bg-gray-800 text-gray-600 dark:text-gray-300 text-center urdu-text border border-gray-200 dark:border-gray-700">@Model.BazoDetail</div>
                    }
                </div>
                
                <!-- Hem (Daman) Type -->
                <div class="space-y-2">
                    <label class="block text-lg font-semibold text-gray-700 dark:text-gray-300 text-center urdu-text">دامن</label>
                    <div class="p-3 rounded-xl border-2 border-primary-200 dark:border-primary-700 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-400 flex flex-col items-center justify-center h-20">
                        @if(Model.GheraType == 2) {
                            <svg class="w-8 h-8 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4v16h16V4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span class="text-sm font-bold urdu-text">چورس دامن</span>
                        } else if(Model.GheraType == 1) {
                            <svg class="w-8 h-8 mb-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4v10c0 3.314 2.686 6 6 6h4c3.314 0 6-2.686 6-6V4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <span class="text-sm font-bold urdu-text">گول دامن</span>
                        } else {
                            <span class="text-sm font-bold text-gray-400 urdu-text">--</span>
                        }
                    </div>
                </div>

                <!-- Pockets -->
                <div class="space-y-2 col-span-2 sm:col-span-1">
                    <label class="block text-lg font-semibold text-gray-700 dark:text-gray-300 text-center urdu-text">پاکٹ</label>
                    <div class="grid grid-cols-1 gap-2">
                        <div class="flex flex-row-reverse items-center justify-between px-3 py-1.5 rounded-lg border-2 @(Model.IsFrontPocket ? "border-primary-500 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-400" : "border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-400 dark:text-gray-500")">
                            <span class="text-sm font-bold urdu-text" dir="rtl">سامنے پاکٹ</span>
                            @if(Model.IsFrontPocket) {
                                <span class="text-primary-500 font-bold">✓</span>
                            } else {
                                <span class="font-bold opacity-50">X</span>
                            }
                        </div>
                        <div class="flex flex-row-reverse items-center justify-between px-3 py-1.5 rounded-lg border-2 @(Model.IsDoubleSidePocket ? "border-primary-500 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-400" : "border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-400 dark:text-gray-500")">
                            <span class="text-sm font-bold urdu-text" dir="rtl">سائیڈ پاکٹ</span>
                            @if(Model.IsDoubleSidePocket) {
                                <span class="text-primary-500 font-bold">✓</span>
                            } else {
                                <span class="font-bold opacity-50">X</span>
                            }
                        </div>
                        <div class="flex flex-row-reverse items-center justify-between px-3 py-1.5 rounded-lg border-2 @(Model.IsShalwarPocket ? "border-primary-500 bg-primary-50 dark:bg-primary-900/20 text-primary-700 dark:text-primary-400" : "border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 text-gray-400 dark:text-gray-500")">
                            <span class="text-sm font-bold urdu-text" dir="rtl">شلوار پاکٹ</span>
                            @if(Model.IsShalwarPocket) {
                                <span class="text-primary-500 font-bold">✓</span>
                            } else {
                                <span class="font-bold opacity-50">X</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="mt-6 border-t border-gray-100 dark:border-gray-800 pt-5">
                <h4 class="text-lg font-bold text-gray-500 dark:text-gray-400 mb-3">Stitching & Pati</h4>
                <div class="flex flex-wrap gap-4 items-center">
                    <div class="flex items-center gap-2">
                        @if(Model.IsCheckPatiKaj) {
                            <span class="text-primary-600 font-bold text-lg">☑</span>
                        } else {
                            <span class="text-gray-300 dark:text-gray-700 font-bold text-lg">☐</span>
                        }
                        <span class="text-sm font-bold text-gray-700 dark:text-gray-300 urdu-text">پٹی کاج</span>
                    </div>
                    
                    @if(!string.IsNullOrEmpty(Model.Pati)) {
                        <div class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 font-medium">
                            <span class="text-gray-400 mr-2">Pati:</span> @Model.Pati
                        </div>
                    }
                </div>
            </div>

            <div class="mt-6 border-t border-gray-100 dark:border-gray-800 pt-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <h4 class="text-sm font-bold text-gray-500 dark:text-gray-400 mb-2">Design Notes</h4>
                    <div class="p-3 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 min-h-[80px] text-sm text-gray-700 dark:text-gray-300">
                        @(string.IsNullOrEmpty(Model.Design) ? "--" : Model.Design)
                    </div>
                </div>
                <div>
                    <h4 class="text-sm font-bold text-gray-500 dark:text-gray-400 mb-2">Other Details</h4>
                    <div class="p-3 rounded-xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900 min-h-[80px] text-sm text-gray-700 dark:text-gray-300 urdu-text leading-relaxed">
                        @(string.IsNullOrEmpty(Model.OtherDetails) ? "--" : Model.OtherDetails)
                    </div>
                </div>
            </div>

            </div>

            <!-- Quick Actions -->
            <div data-html2canvas-ignore="true" class="mt-6 pt-5 border-t border-gray-100 dark:border-gray-800 flex justify-end">
                <button type="button" 
                        onclick="saveMeasurementSlip('@Model.RegisterNo', '@Model.CustomerName')"
                        class="w-full sm:w-auto min-w-[160px] flex justify-center items-center gap-2 px-6 py-2.5 bg-gray-900 hover:bg-gray-800 dark:bg-gray-100 dark:hover:bg-white text-white dark:text-gray-900 font-semibold rounded-xl shadow-md transition-all hover:scale-[1.02] active:scale-[0.98]">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                    Save Slip
                </button>
            </div>

        </div>
    </div>
</div>


