@model TailorApp.Models.Size
@{
    ViewData["Title"] = $"Measurement #{Model.RegisterNo}";
    
    // Sync stitching options from Design / OtherDetails string
    bool isSingleSalai = (Model.OtherDetails?.Contains("سنگل سلائی") ?? false) || (Model.Design?.Contains("سنگل سلائی") ?? false);
    bool isDoubleSalai = (Model.OtherDetails?.Contains("ڈبل سلائی") ?? false) || (Model.Design?.Contains("ڈبل سلائی") ?? false);
    bool isTripleSalai = (Model.OtherDetails?.Contains("ٹرپل سلائی") ?? false) || (Model.Design?.Contains("ٹرپل سلائی") ?? false);
    bool isChokaSalai = (Model.OtherDetails?.Contains("چوکہ سلائی") ?? false) || (Model.Design?.Contains("چوکہ سلائی") ?? false) || 
                        (Model.OtherDetails?.Contains("چار سلائی") ?? false) || (Model.Design?.Contains("چار سلائی") ?? false) ||
                        (Model.OtherDetails?.Contains("چوکہ") ?? false) || (Model.Design?.Contains("چوکہ") ?? false);
}

<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 max-w-[460px] mx-auto">
    <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.Customer_ID" class="inline-flex items-center text-xs font-bold text-gray-500 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400 transition-colors">
        <span class="mr-1">←</span> Back to @Model.CustomerName
    </a>
    <a asp-controller="Sizes" asp-action="Edit" asp-route-id="@Model.SizeID" class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 bg-gray-900 hover:bg-black dark:bg-primary-600 dark:hover:bg-primary-700 text-white text-xs font-bold rounded-xl shadow transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z" /></svg> Edit
    </a>
</div>

<div id="measurement-capture-card" class="bg-[#fcfbf7] text-gray-900 border-2 border-gray-900 rounded-[2rem] shadow-xl overflow-hidden relative max-w-[460px] mx-auto p-5 font-sans select-none">
    
    <!-- Serrated Wavy Top Edge -->
    <div class="absolute top-0 left-0 w-full h-3 bg-repeat-x" style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;12&quot; height=&quot;8&quot; viewBox=&quot;0 0 12 8&quot;><polygon points=&quot;0,8 6,0 12,8&quot; fill=&quot;%23999999&quot;/></svg>');"></div>
    
    <!-- Receipt Header -->
    <div class="mt-4 text-center">
        <h2 class="text-3xl font-black text-black tracking-wide urdu-text text-center">غنی ٹیلرز اینڈ فیبرکس</h2>
        <div class="flex justify-between items-center text-xs font-bold text-gray-700 mt-1 px-1">
            <div dir="ltr" class="font-mono">غنی: 9073880-0345</div>
            <div class="urdu-text text-sm font-extrabold">رجسٹرڈ</div>
        </div>
    </div>
    
    <!-- Double Divider Line -->
    <div class="my-2 border-t border-b border-black h-0.5"></div>
    
    <!-- Sub-header (Customer Info Grid) -->
    <div class="grid grid-cols-3 gap-1 text-center py-1 bg-gray-100/50 rounded-lg border border-gray-300">
        <div>
            <div class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">REG NO</div>
            <div class="text-[15px] font-black font-mono text-black">#@Model.RegisterNo</div>
        </div>
        <div class="border-l border-r border-gray-300 px-1">
            <div class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">NAME</div>
            <div class="text-[14px] font-bold text-black urdu-text truncate">@Model.CustomerName</div>
        </div>
        <div>
            <div class="text-[10px] text-gray-500 font-bold uppercase tracking-wider">KARIGAR</div>
            <div class="text-[14px] font-bold text-black">Master</div>
        </div>
    </div>
    
    <!-- Divider -->
    <div class="my-3 border-t-2 border-black"></div>
    
    <!-- Main Content Grid (Side-by-Side) -->
    <div class="grid grid-cols-12 gap-3 items-stretch">
        
        <!-- Left Column: Visual Options (55% width) -->
        <div class="col-span-7 flex flex-col justify-between space-y-2">
            
            <!-- Collar Box -->
            <div class="border border-gray-300 rounded-xl p-1.5 bg-white/60 relative">
                <span class="absolute top-1 right-2 text-[9px] font-bold text-gray-400 urdu-text leading-none">کالر / بین</span>
                <div class="grid grid-cols-2 gap-1.5 mt-2.5">
                    <div class="flex flex-col items-center justify-center p-1 rounded-lg border-2 h-[52px] transition-all @(Model.CalarType == 1 ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-black" : "border-gray-200/60 bg-gray-50/30 text-gray-400 opacity-60")">
                        <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6l8 4 8-4M4 6v4l8 4 8-4V6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="text-[10px] font-bold urdu-text leading-none">کالر</span>
                    </div>
                    <div class="flex flex-col items-center justify-center p-1 rounded-lg border-2 h-[52px] transition-all @(Model.CalarType == 2 ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-black" : "border-gray-200/60 bg-gray-50/30 text-gray-400 opacity-60")">
                        <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8c0-2 4-3 6-3s6 1 6 3v2c0 2-4 3-6 3s-6-1-6-3V8z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="text-[10px] font-bold urdu-text leading-none">قول بین</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.CalarDetail))
                {
                    <div class="w-full mt-1 px-1.5 py-0.5 text-[10px] rounded-md bg-gray-100 text-gray-700 text-center urdu-text border border-gray-200 truncate" title="@Model.CalarDetail">@Model.CalarDetail</div>
                }
            </div>

            <!-- Sleeve Box -->
            <div class="border border-gray-300 rounded-xl p-1.5 bg-white/60 relative">
                <span class="absolute top-1 right-2 text-[9px] font-bold text-gray-400 urdu-text leading-none">آستین</span>
                <div class="grid grid-cols-2 gap-1.5 mt-2.5">
                    <div class="flex flex-col items-center justify-center p-1 rounded-lg border-2 h-[52px] transition-all @(Model.BazoType == 1 ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-black" : "border-gray-200/60 bg-gray-50/30 text-gray-400 opacity-60")">
                        <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 4h8l-2 16h-4L8 4z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="text-[10px] font-bold urdu-text leading-none">گول بازو</span>
                    </div>
                    <div class="flex flex-col items-center justify-center p-1 rounded-lg border-2 h-[52px] transition-all @(Model.BazoType == 2 ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-black" : "border-gray-200/60 bg-gray-50/30 text-gray-400 opacity-60")">
                        <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 4h8l-2 12h2v4H6v-4h2L8 4z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="text-[10px] font-bold urdu-text leading-none">کف</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.BazoDetail))
                {
                    <div class="w-full mt-1 px-1.5 py-0.5 text-[10px] rounded-md bg-gray-100 text-gray-700 text-center urdu-text border border-gray-200 truncate" title="@Model.BazoDetail">@Model.BazoDetail</div>
                }
            </div>

            <!-- Daman Box -->
            <div class="border border-gray-300 rounded-xl p-1.5 bg-white/60 relative">
                <span class="absolute top-1 right-2 text-[9px] font-bold text-gray-400 urdu-text leading-none">دامن</span>
                <div class="grid grid-cols-2 gap-1.5 mt-2.5">
                    <div class="flex flex-col items-center justify-center p-1 rounded-lg border-2 h-[52px] transition-all @(Model.GheraType == 1 ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-black" : "border-gray-200/60 bg-gray-50/30 text-gray-400 opacity-60")">
                        <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v10c0 3.314 2.686 6 6 6h4c3.314 0 6-2.686 6-6V4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="text-[10px] font-bold urdu-text leading-none">گول دامن</span>
                    </div>
                    <div class="flex flex-col items-center justify-center p-1 rounded-lg border-2 h-[52px] transition-all @(Model.GheraType == 2 ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-black" : "border-gray-200/60 bg-gray-50/30 text-gray-400 opacity-60")">
                        <svg class="w-5 h-5 mb-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4v16h16V4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <span class="text-[10px] font-bold urdu-text leading-none">چورس دامن</span>
                    </div>
                </div>
            </div>

            <!-- Pocket Box -->
            <div class="border border-gray-300 rounded-xl p-1.5 bg-white/60 relative">
                <span class="absolute top-1 right-2 text-[9px] font-bold text-gray-400 urdu-text leading-none">پاکٹ</span>
                <div class="grid grid-cols-3 gap-1 mt-2.5">
                    <div class="flex flex-col items-center justify-center p-1 rounded-lg border-2 h-[48px] transition-all @(Model.IsFrontPocket ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-black" : "border-gray-200/60 bg-gray-50/30 text-gray-400 opacity-60")">
                        <span class="text-[9px] font-bold urdu-text leading-none">پاکٹ</span>
                    </div>
                    <div class="flex flex-col items-center justify-center p-1 rounded-lg border-2 h-[48px] transition-all @(Model.IsDoubleSidePocket ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-black" : "border-gray-200/60 bg-gray-50/30 text-gray-400 opacity-60")">
                        <span class="text-[9px] font-bold urdu-text leading-none text-center">سائیڈ پاکٹ</span>
                    </div>
                    <div class="flex flex-col items-center justify-center p-1 rounded-lg border-2 h-[48px] transition-all @(Model.IsShalwarPocket ? "border-indigo-600 bg-indigo-50/50 text-indigo-700 font-black" : "border-gray-200/60 bg-gray-50/30 text-gray-400 opacity-60")">
                        <span class="text-[9px] font-bold urdu-text leading-none text-center">شلوار پاکٹ</span>
                    </div>
                </div>
            </div>
            
            <!-- Stitching Options List (Urdu Checkboxes) -->
            <div class="pt-1.5 space-y-1.5 text-[11px] font-semibold text-gray-700 dark:text-gray-300 pl-1 font-sans">
                <div class="flex items-center gap-2">
                    <span class="text-sm font-bold @(isSingleSalai ? "text-indigo-600" : "text-gray-300")">@(isSingleSalai ? "☑" : "☐")</span>
                    <span class="urdu-text text-[13px] @(isSingleSalai ? "text-black font-bold" : "text-gray-400")">چمک تار سنگل سلائی</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-sm font-bold @(isDoubleSalai ? "text-indigo-600" : "text-gray-300")">@(isDoubleSalai ? "☑" : "☐")</span>
                    <span class="urdu-text text-[13px] @(isDoubleSalai ? "text-black font-bold" : "text-gray-400")">چمک تار ڈبل سلائی</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-sm font-bold @(isTripleSalai ? "text-indigo-600" : "text-gray-300")">@(isTripleSalai ? "☑" : "☐")</span>
                    <span class="urdu-text text-[13px] @(isTripleSalai ? "text-black font-bold" : "text-gray-400")">چمک تار ٹرپل سلائی</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-sm font-bold @(isChokaSalai ? "text-indigo-600" : "text-gray-300")">@(isChokaSalai ? "☑" : "☐")</span>
                    <span class="urdu-text text-[13px] @(isChokaSalai ? "text-black font-bold" : "text-gray-400")">چمک تار چوکہ سلائی</span>
                </div>
            </div>

        </div>
        
        <!-- Vertical Divider (Thick black line) -->
        <div class="col-span-1 flex justify-center items-stretch py-1">
            <div class="w-0.5 bg-black h-full"></div>
        </div>
        
        <!-- Right Column: Measurements Table (45% width) -->
        <div class="col-span-4 flex flex-col justify-center">
            <div class="border border-black rounded-lg overflow-hidden bg-white shadow-sm font-mono">
                <table class="w-full text-xs text-left border-collapse">
                    <tbody class="divide-y divide-gray-300">
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-1.5 px-2 font-black text-center text-lg text-black bg-gray-50/30">@(string.IsNullOrEmpty(Model.Lambai) ? "--" : Model.Lambai)</td>
                            <td class="py-1.5 px-2 font-extrabold text-right border-l border-gray-300 bg-gray-100/10 text-gray-800 urdu-text text-base w-[40%] leading-none" dir="rtl">لمبائی</td>
                        </tr>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-1.5 px-2 font-black text-center text-lg text-black bg-gray-50/30">@(string.IsNullOrEmpty(Model.Bazo) ? "--" : Model.Bazo)</td>
                            <td class="py-1.5 px-2 font-extrabold text-right border-l border-gray-300 bg-gray-100/10 text-gray-800 urdu-text text-base leading-none" dir="rtl">آستین</td>
                        </tr>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-1.5 px-2 font-black text-center text-lg text-black bg-gray-50/30">@(string.IsNullOrEmpty(Model.Tera) ? "--" : Model.Tera)</td>
                            <td class="py-1.5 px-2 font-extrabold text-right border-l border-gray-300 bg-gray-100/10 text-gray-800 urdu-text text-base leading-none" dir="rtl">تیرا</td>
                        </tr>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-1.5 px-2 font-black text-center text-lg text-black bg-gray-50/30">@(string.IsNullOrEmpty(Model.Calar) ? "--" : Model.Calar)</td>
                            <td class="py-1.5 px-2 font-extrabold text-right border-l border-gray-300 bg-gray-100/10 text-gray-800 urdu-text text-base leading-none" dir="rtl">کالر</td>
                        </tr>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-1.5 px-2 font-black text-center text-lg text-black bg-gray-50/30">@(string.IsNullOrEmpty(Model.Chati) ? "--" : Model.Chati)</td>
                            <td class="py-1.5 px-2 font-extrabold text-right border-l border-gray-300 bg-gray-100/10 text-gray-800 urdu-text text-base leading-none" dir="rtl">چھاتی</td>
                        </tr>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-1.5 px-2 font-black text-center text-lg text-black bg-gray-50/30">@(string.IsNullOrEmpty(Model.Kamar) ? "--" : Model.Kamar)</td>
                            <td class="py-1.5 px-2 font-extrabold text-right border-l border-gray-300 bg-gray-100/10 text-gray-800 urdu-text text-base leading-none" dir="rtl">کمر</td>
                        </tr>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-1.5 px-2 font-black text-center text-lg text-black bg-gray-50/30">@(string.IsNullOrEmpty(Model.Ghera) ? "--" : Model.Ghera)</td>
                            <td class="py-1.5 px-2 font-extrabold text-right border-l border-gray-300 bg-gray-100/10 text-gray-800 urdu-text text-base leading-none" dir="rtl">دامن</td>
                        </tr>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-1.5 px-2 font-black text-center text-lg text-black bg-gray-50/30">@(string.IsNullOrEmpty(Model.ShalwarLambai) ? "--" : Model.ShalwarLambai)</td>
                            <td class="py-1.5 px-2 font-extrabold text-right border-l border-gray-300 bg-gray-100/10 text-gray-800 urdu-text text-base leading-none" dir="rtl">شلوار</td>
                        </tr>
                        <tr class="hover:bg-gray-50/50">
                            <td class="py-1.5 px-2 font-black text-center text-lg text-black bg-gray-50/30">@(string.IsNullOrEmpty(Model.Pancha) ? "--" : Model.Pancha)</td>
                            <td class="py-1.5 px-2 font-extrabold text-right border-l border-gray-300 bg-gray-100/10 text-gray-800 urdu-text text-base leading-none" dir="rtl">پانچہ</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
    
    <!-- Footer Section with Date -->
    <div class="mt-4 flex justify-end px-1">
        <span class="text-xs font-black font-mono text-gray-700">Date: @DateTime.Now.ToString("dd-05-yyyy")</span>
    </div>
    
    <!-- Note Box -->
    <div class="bg-black text-white text-center text-[10px] font-bold py-2 px-4 rounded-xl leading-normal urdu-text mt-2 border border-gray-800">
        نوٹ: رسید گم ہو جانے پر اگر عدد میں کسی قسم کی بھی غلطی ہوئی تو اسکا ذمہ دار کاریگر ہوگا
    </div>
    
</div>

<!-- Outside the Card (Quick Actions, hidden during image generation) -->
<div data-html2canvas-ignore="true" class="mt-4 flex gap-3 max-w-[460px] mx-auto">
    <button type="button" 
            onclick="saveMeasurementSlip('@Model.RegisterNo', '@Model.CustomerName')"
            class="flex-1 flex justify-center items-center gap-2 px-5 py-2.5 bg-gray-900 hover:bg-black text-white font-bold rounded-xl shadow-md transition-all hover:scale-[1.02] active:scale-[0.98] text-xs">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
        Save Slip Image
    </button>
    <button type="button" 
            onclick="shareMeasurementSlip('@Model.RegisterNo', '@Model.CustomerName')"
            class="flex-1 flex justify-center items-center gap-2 px-5 py-2.5 bg-[#0ea5e9] hover:bg-[#0284c7] text-white font-bold rounded-xl shadow-md transition-all hover:scale-[1.02] active:scale-[0.98] text-xs">
        <!-- WhatsApp Icon SVG -->
        <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946C.06 5.348 5.397.01 12.008.01c3.202.001 6.212 1.246 8.477 3.514 2.266 2.268 3.507 5.28 3.505 8.484-.004 6.657-5.34 11.997-11.953 11.997-2.005-.001-3.973-.502-5.724-1.455L0 24zm6.59-4.846c1.665.989 3.3 1.489 4.932 1.49 5.428 0 9.845-4.415 9.848-9.845.002-2.63-1.023-5.101-2.887-6.963C16.677 1.973 14.204 1.1 11.581 1.1 6.151 1.1 1.734 5.515 1.731 10.947c-.001 1.751.462 3.41 1.34 4.871l-.88 3.216 3.298-.865zm12.35-6.9c-.314-.157-1.86-.92-2.148-1.025-.289-.105-.499-.157-.708.157-.208.314-.808 1.025-.99 1.235-.181.208-.363.235-.678.079-1.343-.672-2.222-1.181-3.111-2.709-.236-.404.236-.375.678-1.258.079-.157.04-.294-.02-.404-.059-.111-.499-1.205-.684-1.65-.18-.435-.363-.375-.499-.382-.128-.007-.276-.007-.423-.007-.147 0-.387.056-.589.276-.202.221-.772.756-.772 1.84s.79 2.128.902 2.284c.111.157 1.554 2.379 3.766 3.328.526.226.937.362 1.258.464.529.167 1.011.144 1.392.087.426-.064 1.3-.532 1.485-1.046.186-.514.186-.956.131-1.047-.056-.09-.203-.143-.515-.302z"/></svg>
        WhatsApp Slip
    </button>
</div>
